{
  "name": "@bifrost/browser",
  "version": "0.1.1",
  "private": true,
  "description": "BIFROST-controlled browser surface for verifying AI answers in-page.",
  "main": "desktop/main.cjs",
  "author": "JourdanLabs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "cap": "cap",
    "desktop:dev": "pnpm build && electron desktop/main.cjs",
    "desktop:pack": "pnpm build && electron-builder --config desktop/electron-builder.json --mac dmg",
    "dev": "node scripts/build.mjs --watch",
    "ios:open": "cap open ios",
    "ios:sync": "pnpm build && cap sync ios",
    "test": "node scripts/smoke.mjs",
    "serve": "npx serve dist -l 8795"
  },
  "dependencies": {
    "@bifrost/types": "workspace:*",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0",
    "esbuild": "^0.21.0"
  }
}
