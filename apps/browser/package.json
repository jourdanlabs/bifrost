{
  "name": "@bifrost/browser",
  "version": "0.1.0",
  "private": true,
  "description": "BIFROST-controlled browser surface for verifying AI answers in-page.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "cap": "cap",
    "dev": "node scripts/build.mjs --watch",
    "ios:open": "cap open ios",
    "ios:sync": "pnpm build && cap sync ios",
    "test": "node scripts/smoke.mjs",
    "serve": "npx serve dist -l 8795"
  },
  "dependencies": {
    "@bifrost/types": "workspace:*",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "esbuild": "^0.21.0"
  }
}
